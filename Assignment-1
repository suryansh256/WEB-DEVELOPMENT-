/CSS 
#box{
    width: 100%;
    height:100%;
    background-color: aqua;
}
#card {
    width: 300px;
    height: 500px;
    border: 5px solid black;
    border-radius: 5px;
    color: rgb(150, 196, 236);
    margin: left 35%;
    margin: auto;
    background-color: rgb(202, 226, 226);
    box-shadow: 10px;



}

#text{
    width: 200px;
    padding: 5px;
    font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
    background-color: bisque;
    text-align: center;
    margin:auto;
   border-radius: 50px;
    color: black;
    font-size: 11px;



}

.image {
    width: 100%;
    height: 200px;
    border-radius: 5px;
    margin-bottom: 25px;
    margin-top: 15px;

}

.image img {
    width: 70%;
    height: 100%;
    object-fit: cover;
    border-radius: 70px;
    margin-left: 15%;



}

.stars {
    height: 70px;
    margin: auto;
    
}

.stars h5 {
    text-align: center;
color: rgb(2, 2, 2);
}
